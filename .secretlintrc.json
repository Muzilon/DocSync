{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "URL assinada do Power Automate / Logic Apps",
            "pattern": "/https?:\\/\\/[^\\s\"']*(logic\\.azure\\.com|powerplatform\\.com|powerautomate)[^\\s\"']*sig=[A-Za-z0-9%_\\-]+/i"
          },
          {
            "name": "Parâmetro de assinatura em URL",
            "pattern": "/[?&](sig|sv|se|sp)=[A-Za-z0-9%_\\-]{16,}/"
          },
          {
            "name": "Client secret do Entra ID",
            "pattern": "/[A-Za-z0-9_~.\\-]{3}8Q~[A-Za-z0-9_~.\\-]{31,34}/"
          },
          {
            "name": "Senha atribuída em texto",
            "pattern": "/(senha|password|client_secret|CLIENT_SECRET)\\s*[:=]\\s*[\"']?(?!<)[^\\s\"'<>]{6,}/i"
          },
          {
            "name": "Cadeia de conexão com senha",
            "pattern": "/postgres(ql)?:\\/\\/[^:\\s]+:(?!<)[^@\\s]+@/i"
          }
        ]
      }
    }
  ]
}
