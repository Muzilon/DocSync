# Copie para .env (não versionado) e preencha os valores reais.
# Este arquivo só pode conter placeholders. Nunca coloque valor real aqui.

# Ambiente
APP_AMBIENTE=desenvolvimento
API_PORTA=3001
WEB_ORIGEM=http://localhost:5173

# Autenticação corporativa (Microsoft Entra ID)
# Tenant ID e Client ID não são segredos, mas ficam fora do código por organização.
ENTRA_TENANT_ID=<id-do-locatario>
ENTRA_CLIENT_ID=<id-do-aplicativo>
VITE_ENTRA_TENANT_ID=<id-do-locatario>
VITE_ENTRA_CLIENT_ID=<id-do-aplicativo>
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# Primeiro administrador (decisão 0007), usado só enquanto não houver administrador ativo no banco.
# Lista separada por vírgula; o e-mail é comparado sem diferenciar maiúsculas.
ADMINISTRADORES_INICIAIS=<email-corporativo>

# Banco de dados local PGlite (decisão 0003); pasta fora do Git
BANCO_PASTA=./dados-locais/banco

# Armazenamento de arquivos local (decisão 0003)
ARMAZENAMENTO_PASTA=./armazenamento-local

# SharePoint (somente quando liberado pela TI; sempre no servidor)
SHAREPOINT_SITE_ID=<id-do-site>
SHAREPOINT_BIBLIOTECA_ID=<id-da-biblioteca>
